{
  "name": "finalshop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "postcss": "^8.5.23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.11.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
