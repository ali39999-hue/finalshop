# Local development values (copy to .env — never commit .env).
# Matches infra/docker/docker-compose.dev.yml.
DATABASE_URL="postgresql://finalshop:finalshop@localhost:5432/finalshop"
REDIS_URL="redis://localhost:6379"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev_meili_master_key_change_me"

# Storefront / ERP console (demo org + optional real search engine swap).
DEMO_ORG_SLUG="demo"
# When set, the storefront search index runs on Meilisearch instead of the
# DB-backed index (composition-root swap, W11).
# MEILI_URL="http://localhost:7700"
# MEILI_API_KEY="dev_meili_master_key_change_me"
# MEILI_INDEX="catalog"
